#include <stdio.h>
void main() {
	int octalEight = 010;
	//Assign octal literal '010' to int data type.
	printf("octalEight value = %d\n", octalEight);
	int hexTen = 0xA;
	//Assign hexadecimal literal '0xA' to int data type.
	printf("hexTen value = %d\n", hexTen);
	char asciiValueOfOne = 49;
	//Assign charcater literal '1' to int data type.
	printf("asciiValueOfOne value = %d\n", asciiValueOfOne);
	char asciiValueOfA = 'A';
	//Assign charcater literal 'A' to int data type.
	printf("asciiValueOfA value = %d\n", asciiValueOfA);

	
}
